sap.ui.define([                                                                                                                                                                                                                                                
    "sap/ui/core/mvc/Controller",                                                                                                                                                                                                                              
    "sap/m/MessageBox",                                                                                                                                                                                                                                        
    "sap/ui/core/UIComponent",                                                                                                                                                                                                                                 
    "sap/m/BusyDialog"                                                                                                                                                                                                                                         
], (Controller, MessageBox, UIComponent, BusyDialog) => {                                                                                                                                                                                                      
    "use strict";                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
    var ManufacturingOrder;                                                                                                                                                                                                                                    
    var ManufacturingOrderOperation;                                                                                                                                                                                                                           
    var ConfQty;                                                                                                                                                                                                                                               
    var PlnConfQty;                                                                                                                                                                                                                                            
    var PlnConfUom;                                                                                                                                                                                                                                            
    var PalCnt;                                                                                                                                                                                                                                                
    var sToBeConfQty;                                                                                                                                                                                                                                          
    var sToBeConfUom;                                                                                                                                                                                                                                          
    var NonOrderType;                                                                                                                                                                                                                                          
    var vCBPalCode;                                                                                                                                                                                                                                            
    var oBusyDialog = new BusyDialog({});                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
    var serror;                                                                                                                                                                                                                                                
    var srequired;                                                                                                                                                                                                                                             
    var swarning;                                                                                                                                                                                                                                              
    var sconfirmtext;                                                                                                                                                                                                                                          
    var sconfirmunit;                                                                                                                                                                                                                                          
    var sconfirmqty;                                                                                                                                                                                                                                           
    var sconfirmqtyn;                                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
    return Controller.extend("procorderconfirm.controller.View1", {                                                                                                                                                                                            
        onInit() {                                                                                                                                                                                                                                             
            //Set busy loading screen                                                                                                                                                                                                                          
            oBusyDialog.open();                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
            var oRouter = UIComponent.getRouterFor(this);                                                                                                                                                                                                      
            oRouter.getRoute("View1").attachPatternMatched(this._onRoutePattern, this);                                                                                                                                                                        
                                                                                                                                                                                                                                                               
            serror = this.getOwnerComponent().getModel("i18n").getResourceBundle().getText("error");                                                                                                                                                           
            srequired = this.getOwnerComponent().getModel("i18n").getResourceBundle().getText("required");                                                                                                                                                     
            swarning = this.getOwnerComponent().getModel("i18n").getResourceBundle().getText("warning");                                                                                                                                                       
            sconfirmtext = this.getOwnerComponent().getModel("i18n").getResourceBundle().getText("confirmtext");                                                                                                                                               
            sconfirmunit = this.getOwnerComponent().getModel("i18n").getResourceBundle().getText("confirmunit");                                                                                                                                               
            sconfirmqty = this.getOwnerComponent().getModel("i18n").getResourceBundle().getText("confirmqty");                                                                                                                                                 
            sconfirmqtyn = this.getOwnerComponent().getModel("i18n").getResourceBundle().getText("confirmqtyn");                                                                                                                                               
                                                                                                                                                                                                                                                               
            //Handle hotkeys                                                                                                                                                                                                                                   
            $(document).keydown(jQuery.proxy(this.onKeyDown, this));                                                                                                                                                                                           
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        onKeyDown: function (oEvent) {                                                                                                                                                                                                                         
            // F3 - Back                                                                                                                                                                                                                                       
            if (oEvent.key === "F3") {                                                                                                                                                                                                                         
                oEvent.preventDefault();                                                                                                                                                                                                                       
                this._onBack();                                                                                                                                                                                                                                
            }                                                                                                                                                                                                                                                  
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        OnTypeUpper: function (oEvent) {                                                                                                                                                                                                                       
            var oInput = oEvent.getSource();                                                                                                                                                                                                                   
            var sCurrentValue = oInput.getValue();                                                                                                                                                                                                             
            oInput.setValue(sCurrentValue.toUpperCase());                                                                                                                                                                                                      
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        _onRoutePattern: function (oEvent) {                                                                                                                                                                                                                   
                                                                                                                                                                                                                                                               
            this.getView().byId("ToBeConfQty").setValue("");                                                                                                                                                                                                   
            this.getView().byId("ToBeConfUom").setValue("");                                                                                                                                                                                                   
            this.getView().byId("CBPalCode").setValue("");                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
            var vProcOder = oEvent.getParameter("arguments").ProcOrder;                                                                                                                                                                                        
            var vPhase = oEvent.getParameter("arguments").Phase;                                                                                                                                                                                               
                                                                                                                                                                                                                                                               
            var sPath = "/ProcOrdGetDtl(ProcessOrder='" + vProcOder + "',Operation='" + vPhase + "')/Set";                                                                                                                                                     
            var oModel = this.getView().getModel();                                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
            oModel.read(sPath, {                                                                                                                                                                                                                               
                success: function (oData) {                                                                                                                                                                                                                    
                    var resultsArray = oData.results;                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
                    ManufacturingOrder = resultsArray[0].ManufacturingOrder;                                                                                                                                                                                   
                    this.getView().byId("FldProcOrderV").setValue(ManufacturingOrder);                                                                                                                                                                         
                                                                                                                                                                                                                                                               
                    ManufacturingOrderOperation = resultsArray[0].ManufacturingOrderOperation;                                                                                                                                                                 
                    ManufacturingOrderOperation = ManufacturingOrderOperation.padStart(4, '0');                                                                                                                                                                
                    this.getView().byId("FldPhaseV").setValue(ManufacturingOrderOperation);                                                                                                                                                                    
                                                                                                                                                                                                                                                               
                    ConfQty = resultsArray[0].MfgOrderConfirmedYieldQty;                                                                                                                                                                                       
                    this.getView().byId("ConfQty").setValue(ConfQty);                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
                    PlnConfQty = resultsArray[0].MfgOrderPlannedTotalQty;                                                                                                                                                                                      
                    this.getView().byId("PlnConfQty").setValue(PlnConfQty);                                                                                                                                                                                    
                                                                                                                                                                                                                                                               
                    PlnConfUom = resultsArray[0].ProductionUnit;                                                                                                                                                                                               
                    this.getView().byId("PlnConfUom").setValue(PlnConfUom);                                                                                                                                                                                    
                                                                                                                                                                                                                                                               
                    PalCnt = resultsArray[0].PalletCount;                                                                                                                                                                                                      
                    this.getView().byId("PalCnt").setValue(PalCnt);                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
                    sToBeConfQty = resultsArray[0].ToBeConfirmedQty;                                                                                                                                                                                           
                    if (sToBeConfQty > 0) {                                                                                                                                                                                                                    
                        this.getView().byId("ToBeConfQty").setValue(sToBeConfQty);                                                                                                                                                                             
                    }                                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
                    sToBeConfUom = resultsArray[0].ProductionUnit;                                                                                                                                                                                             
                    this.getView().byId("ToBeConfUom").setValue(sToBeConfUom);                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
                    NonOrderType = resultsArray[0].NonOrderType;                                                                                                                                                                                               
                                                                                                                                                                                                                                                               
                    if (!NonOrderType || NonOrderType.trim() === "") {                                                                                                                                                                                         
                        this.byId("CBPalCode").setVisible(true);                                                                                                                                                                                               
                    } else {                                                                                                                                                                                                                                   
                        this.byId("CBPalCode").setVisible(false);                                                                                                                                                                                              
                    }                                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
                    if (!NonOrderType || NonOrderType.trim() === "") {                                                                                                                                                                                         
                        setTimeout(function () {                                                                                                                                                                                                               
                            this.getView().byId("CBPalCode").focus();                                                                                                                                                                                          
                        }.bind(this), 400);                                                                                                                                                                                                                    
                    } else {                                                                                                                                                                                                                                   
                        setTimeout(function () {                                                                                                                                                                                                               
                            this.getView().byId("ToBeConfQty").focus();                                                                                                                                                                                        
                        }.bind(this), 400);                                                                                                                                                                                                                    
                    }                                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
                    oBusyDialog.close();                                                                                                                                                                                                                       
                }.bind(this),                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
                error: function (oError) {                                                                                                                                                                                                                     
                    var oHistory = sap.ui.core.routing.History.getInstance();                                                                                                                                                                                  
                    var sPreviousHash = oHistory.getPreviousHash();                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
                    if (sPreviousHash !== undefined) {                                                                                                                                                                                                         
                        history.go(-1);                                                                                                                                                                                                                        
                    } else {                                                                                                                                                                                                                                   
                        var oRouter = UIComponent.getRouterFor(this);                                                                                                                                                                                          
                        oRouter.navTo("RouteMain", {}, true);                                                                                                                                                                                                  
                    }                                                                                                                                                                                                                                          
                    oBusyDialog.close();                                                                                                                                                                                                                       
                }.bind(this)                                                                                                                                                                                                                                   
                                                                                                                                                                                                                                                               
            });                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        onBackView: function (oEvent) {                                                                                                                                                                                                                        
            this._onBack();                                                                                                                                                                                                                                    
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        onConfirm: function (oEvent) {                                                                                                                                                                                                                         
                                                                                                                                                                                                                                                               
            var oInput = this.byId("ToBeConfQty");                                                                                                                                                                                                             
            if (oInput) {                                                                                                                                                                                                                                      
                var vToBeConfQty = oInput.getValue();                                                                                                                                                                                                          
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            var oCombo = this.byId("CBPalCode");                                                                                                                                                                                                               
            if (oCombo) {                                                                                                                                                                                                                                      
                vCBPalCode = oCombo.getValue();                                                                                                                                                                                                                
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            if (!NonOrderType || NonOrderType.trim() === "") {                                                                                                                                                                                                 
                if (!vCBPalCode) {                                                                                                                                                                                                                             
                    oCombo.setValueState("Error");                                                                                                                                                                                                             
                    return;                                                                                                                                                                                                                                    
                }                                                                                                                                                                                                                                              
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            oCombo.setValueState("None");                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
            if (parseInt(vToBeConfQty) <= 0) {                                                                                                                                                                                                                 
                var sMsg = sconfirmqty;                                                                                                                                                                                                                        
                MessageBox.error(sMsg, { title: serror });                                                                                                                                                                                                     
                oBusyDialog.close();                                                                                                                                                                                                                           
                oInput.setValueState(sap.ui.core.ValueState.Error);                                                                                                                                                                                            
                oInput.setValueStateText(srequired);                                                                                                                                                                                                           
                return;                                                                                                                                                                                                                                        
            } else {                                                                                                                                                                                                                                           
                oInput.setValueState(sap.ui.core.ValueState.None);                                                                                                                                                                                             
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            var oInput = this.byId("ToBeConfUom");                                                                                                                                                                                                             
            if (oInput) {                                                                                                                                                                                                                                      
                sToBeConfUom = oInput.getValue();                                                                                                                                                                                                              
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            if (sToBeConfUom == "") {                                                                                                                                                                                                                          
                var sMsg = sconfirmunit;                                                                                                                                                                                                                       
                MessageBox.error(sMsg, { title: serror });                                                                                                                                                                                                     
                oBusyDialog.close();                                                                                                                                                                                                                           
                oInput.setValueState(sap.ui.core.ValueState.Error);                                                                                                                                                                                            
                oInput.setValueStateText(srequired);                                                                                                                                                                                                           
                return;                                                                                                                                                                                                                                        
            } else {                                                                                                                                                                                                                                           
                oInput.setValueState(sap.ui.core.ValueState.None);                                                                                                                                                                                             
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            if (parseInt(ConfQty, 10) >= parseInt(PlnConfQty, 10)) {                                                                                                                                                                                           
                MessageBox.show(sconfirmtext, {                                                                                                                                                                                                                
                    icon: MessageBox.Icon.WARNING,                                                                                                                                                                                                             
                    title: swarning,                                                                                                                                                                                                                           
                    actions: [MessageBox.Action.YES, MessageBox.Action.NO],                                                                                                                                                                                    
                    onClose: function (oAction) {                                                                                                                                                                                                              
                        if (oAction === MessageBox.Action.YES) {                                                                                                                                                                                               
                            this._postAPIConfirm(vToBeConfQty);                                                                                                                                                                                                
                        } else {                                                                                                                                                                                                                               
                            return;                                                                                                                                                                                                                            
                        }                                                                                                                                                                                                                                      
                    }.bind(this)                                                                                                                                                                                                                               
                });                                                                                                                                                                                                                                            
            } else {                                                                                                                                                                                                                                           
                                                                                                                                                                                                                                                               
                if (NonOrderType == 'X') {                                                                                                                                                                                                                     
                    this._postAPIConfirm(vToBeConfQty);                                                                                                                                                                                                        
                } else {                                                                                                                                                                                                                                       
                    if (parseInt(vToBeConfQty, 10) == parseInt(sToBeConfQty, 10)) {                                                                                                                                                                            
                        this._postAPIConfirm(vToBeConfQty);                                                                                                                                                                                                    
                    } else {                                                                                                                                                                                                                                   
                        MessageBox.show(sconfirmqtyn, {                                                                                                                                                                                                        
                            icon: MessageBox.Icon.WARNING,                                                                                                                                                                                                     
                            title: swarning,                                                                                                                                                                                                                   
                            actions: [MessageBox.Action.YES, MessageBox.Action.NO],                                                                                                                                                                            
                            onClose: function (oAction) {                                                                                                                                                                                                      
                                if (oAction === MessageBox.Action.YES) {                                                                                                                                                                                       
                                    this._postAPIConfirm(vToBeConfQty);                                                                                                                                                                                        
                                } else {                                                                                                                                                                                                                       
                                    return;                                                                                                                                                                                                                    
                                }                                                                                                                                                                                                                              
                            }.bind(this)                                                                                                                                                                                                                       
                        });                                                                                                                                                                                                                                    
                    }                                                                                                                                                                                                                                          
                }                                                                                                                                                                                                                                              
            }                                                                                                                                                                                                                                                  
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        _onBack: function () {                                                                                                                                                                                                                                 
            var oHistory = sap.ui.core.routing.History.getInstance();                                                                                                                                                                                          
            var sPreviousHash = oHistory.getPreviousHash();&nbsp;                                                                                                                                                                                              
            if (sPreviousHash !== undefined) {                                                                                                                                                                                                                 
                history.go(-1);                                                                                                                                                                                                                                
            } else {                                                                                                                                                                                                                                           
                var oRouter = UIComponent.getRouterFor(this);                                                                                                                                                                                                  
                oRouter.navTo("RouteMain", {}, true);                                                                                                                                                                                                          
            }                                                                                                                                                                                                                                                  
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        _postAPIConfirm: function (vToBeConfQty) {                                                                                                                                                                                                             
                                                                                                                                                                                                                                                               
            oBusyDialog.open();                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
            var sPath = "/ProcOrdConfirm";                                                                                                                                                                                                                     
            var oModel = this.getView().getModel();                                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
            var oPayload = {                                                                                                                                                                                                                                   
                "ManufacturingOrder": ManufacturingOrder,                                                                                                                                                                                                      
                "ManufacturingOrderOperation": ManufacturingOrderOperation,                                                                                                                                                                                    
                "PalletCode": vCBPalCode,                                                                                                                                                                                                                      
                "ToBeConfirmedQty": vToBeConfQty,                                                                                                                                                                                                              
                "ToBeProdUnit": sToBeConfUom                                                                                                                                                                                                                   
            };                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            oModel.create(sPath, oPayload, {                                                                                                                                                                                                                   
                success: function (oData, oResponse) {                                                                                                                                                                                                         
                    //var oRouter = this.getOwnerComponent().getRouter();                                                                                                                                                                                      
                    oBusyDialog.close();                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
                    var sMessage = oResponse.headers["sap-message"];                                                                                                                                                                                           
                    if (sMessage) {                                                                                                                                                                                                                            
                        var oMessage = JSON.parse(sMessage);                                                                                                                                                                                                   
                        var sMsg = oMessage.message;                                                                                                                                                                                                           
                    }                                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
                    MessageBox.success(sMsg, {                                                                                                                                                                                                                 
                        onClose: function (oAction) {&nbsp;                                                                                                                                                                                                    
                            this.getOwnerComponent().getRouter().navTo("RouteMain");                                                                                                                                                                           
                        }.bind(this)                                                                                                                                                                                                                           
                    });                                                                                                                                                                                                                                        
                }.bind(this),                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
                error: function (oError) {                                                                                                                                                                                                                     
                    oBusyDialog.close();                                                                                                                                                                                                                       
                    var sMsg = JSON.parse(oError.responseText).error.message.value;                                                                                                                                                                            
                    sMsg = sMsg.replace(/&&/g, '');                                                                                                                                                                                                            
                    MessageBox.error(sMsg, { title: "Error" });                                                                                                                                                                                                
                }.bind(this)                                                                                                                                                                                                                                   
            });                                                                                                                                                                                                                                                
        }                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
    });                                                                                                                                                                                                                                                        
});&nbsp;&nbsp;&nbsp;&nbsp;                                                                                                                                                                                                                                    