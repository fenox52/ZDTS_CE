<mvc:View controllerName="procordconfirm.controller.View1"                                                                                                                                                                                                     
    xmlns:mvc="sap.ui.core.mvc"                                                                                                                                                                                                                                
    xmlns:core="sap.ui.core"                                                                                                                                                                                                                                   
    xmlns="sap.m"                                                                                                                                                                                                                                              
    xmlns:form="sap.ui.layout.form"&nbsp;&nbsp;&nbsp;&nbsp;                                                                                                                                                                                                    
    >                                                                                                                                                                                                                                                          
    <Page id="page1" title="{i18n>title}">&nbsp;&nbsp;&nbsp;&nbsp;                                                                                                                                                                                             
                                                                                                                                                                                                                                                               
	<VBox class="sapUiSmallMargin">                                                                                                                                                                                                                               
	<form:SimpleForm layout="ResponsiveGridLayout"&nbsp;                                                                                                                                                                                                          
	                 class="centerLabelsForm"                                                                                                                                                                                                                     
			         labelSpanXL="2"                                                                                                                                                                                                                                    
			         labelSpanL="2"                                                                                                                                                                                                                                     
			         labelSpanM="2"                                                                                                                                                                                                                                     
			         labelSpanS="6"                                                                                                                                                                                                                                     
                     adjustLabelSpan="false"                                                                                                                                                                                                                   
                     emptySpanXL="4"                                                                                                                                                                                                                           
                     emptySpanL="4"                                                                                                                                                                                                                            
                     emptySpanM="4"                                                                                                                                                                                                                            
                     emptySpanS="0"                                                                                                                                                                                                                            
                     columnsXL="1"                                                                                                                                                                                                                             
                     columnsL="1"                                                                                                                                                                                                                              
                     columnsM="1"&nbsp;                                                                                                                                                                                                                        
			         singleContainerFullSize="false">                                                                                                                                                                                                                   
&nbsp;                                                                                                                                                                                                                                                         
        <form:content>&nbsp;                                                                                                                                                                                                                                   
        <Label text="Proc.Order" width="100px"/>                                                                                                                                                                                                               
        <Input id="FldProcOrderV"&nbsp;                                                                                                                                                                                                                        
            type="Text"&nbsp;&nbsp;&nbsp;&nbsp;                                                                                                                                                                                                                
            maxLength="12"&nbsp;&nbsp;                                                                                                                                                                                                                         
            editable="false"                                                                                                                                                                                                                                   
            width="120px" />&nbsp;                                                                                                                                                                                                                             
&nbsp;&nbsp;&nbsp;&nbsp;                                                                                                                                                                                                                                       
        <Label text="Oper./Phase" width="100px" />&nbsp;                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
        <Input id="FldPhaseV"                                                                                                                                                                                                                                  
            type="Number"&nbsp;&nbsp;                                                                                                                                                                                                                          
            maxLength="4"&nbsp;                                                                                                                                                                                                                                
            editable="false"                                                                                                                                                                                                                                   
            width="50px"/>&nbsp;                                                                                                                                                                                                                               
        </form:content>	                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
	</form:SimpleForm >                                                                                                                                                                                                                                           
	</VBox  >                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
	<VBox class="sapUiSmallMargin">                                                                                                                                                                                                                               
	<form:SimpleForm layout="ResponsiveGridLayout"&nbsp;                                                                                                                                                                                                          
	                 class="centerLabelsForm"                                                                                                                                                                                                                     
                     labelSpanXL="2"                                                                                                                                                                                                                           
                     labelSpanL="2"                                                                                                                                                                                                                            
                     labelSpanM="2"                                                                                                                                                                                                                            
                     labelSpanS="6"                                                                                                                                                                                                                            
                     adjustLabelSpan="false"                                                                                                                                                                                                                   
                     emptySpanXL="4"                                                                                                                                                                                                                           
                     emptySpanL="4"                                                                                                                                                                                                                            
                     emptySpanM="4"                                                                                                                                                                                                                            
                     emptySpanS="0"                                                                                                                                                                                                                            
                     columnsXL="1"                                                                                                                                                                                                                             
                     columnsL="1"                                                                                                                                                                                                                              
                     columnsM="1"&nbsp;                                                                                                                                                                                                                        
                     singleContainerFullSize="false">&nbsp;                                                                                                                                                                                                    
                                                                                                                                                                                                                                                               
        <form:content>&nbsp;                                                                                                                                                                                                                                   
        <Label text="To Be Confirmed" width="120px" wrapping="true"/>                                                                                                                                                                                          
        <Input  id="ToBeConfQty"&nbsp;                                                                                                                                                                                                                         
                type="Number"&nbsp;&nbsp;&nbsp;                                                                                                                                                                                                                
                maxLength="12"&nbsp;&nbsp;                                                                                                                                                                                                                     
                width="120px"/>&nbsp;&nbsp;                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                               
        <Input  id="ToBeConfUom"                                                                                                                                                                                                                               
                type="Text"&nbsp;&nbsp;                                                                                                                                                                                                                        
                maxLength="3"&nbsp;                                                                                                                                                                                                                            
                width="50px"/>&nbsp;&nbsp;                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        <Label text="Confirmed" width="120px" wrapping="true"/>                                                                                                                                                                                                
        <Input  id="ConfQty"&nbsp;                                                                                                                                                                                                                             
                type="Number"&nbsp;&nbsp;&nbsp;&nbsp;                                                                                                                                                                                                          
                editable="false"                                                                                                                                                                                                                               
                maxLength="12"&nbsp;&nbsp;                                                                                                                                                                                                                     
                width="120px"/>&nbsp;                                                                                                                                                                                                                          
&nbsp;&nbsp;&nbsp;&nbsp;                                                                                                                                                                                                                                       
        <Label text="Planned Conf." width="120px" wrapping="true"/>                                                                                                                                                                                            
        <Input  id="PlnConfQty"&nbsp;                                                                                                                                                                                                                          
                type="Number"&nbsp;&nbsp;&nbsp;&nbsp;                                                                                                                                                                                                          
                editable="false"                                                                                                                                                                                                                               
                maxLength="12"&nbsp;&nbsp;                                                                                                                                                                                                                     
                width="120px"/>&nbsp;&nbsp;                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                               
        <Input  id="PlnConfUom"                                                                                                                                                                                                                                
                type="Text"&nbsp;&nbsp;                                                                                                                                                                                                                        
                editable="false"                                                                                                                                                                                                                               
                maxLength="3"&nbsp;                                                                                                                                                                                                                            
                width="50px"/>&nbsp;&nbsp;                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        <Label text="Pallet Count" width="120px" wrapping="true"/>                                                                                                                                                                                             
        <Input  id="PalCnt"&nbsp;                                                                                                                                                                                                                              
                type="Number"&nbsp;&nbsp;&nbsp;&nbsp;                                                                                                                                                                                                          
                editable="false"&nbsp;                                                                                                                                                                                                                         
                maxLength="4"&nbsp;                                                                                                                                                                                                                            
                width="50px"/>&nbsp;&nbsp;                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        <Label text="Pallet Code" width="120px" wrapping="true"/>                                                                                                                                                                                              
                <Input  id="CBPalCode"&nbsp;                                                                                                                                                                                                                   
                liveChange="OnTypeUpper"                                                                                                                                                                                                                       
                type="Text"&nbsp;&nbsp;&nbsp;&nbsp;                                                                                                                                                                                                            
                editable="true"&nbsp;                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
                maxLength="40"&nbsp;                                                                                                                                                                                                                           
                width="200px"/>&nbsp;&nbsp;                                                                                                                                                                                                                    
        </form:content>                                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                               
	</form:SimpleForm>                                                                                                                                                                                                                                            
	</VBox >                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
                                                                                                                                                                                                                                                               
	<content>                                                                                                                                                                                                                                                     
        <HBox>                                                                                                                                                                                                                                                 
        <Button text="Confirm"                                                                                                                                                                                                                                 
                press="onConfirm">&nbsp;                                                                                                                                                                                                                       
		    <layoutData>                                                                                                                                                                                                                                             
            <FlexItemData growFactor="1" />                                                                                                                                                                                                                    
            </layoutData>                                                                                                                                                                                                                                      
        </Button>                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
        <Button text="F3 - Back"                                                                                                                                                                                                                               
                press="onBackView">&nbsp;                                                                                                                                                                                                                      
            <layoutData>                                                                                                                                                                                                                                       
            <FlexItemData growFactor="1" />                                                                                                                                                                                                                    
            </layoutData>                                                                                                                                                                                                                                      
        </Button>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;                                                                                                                                        
        </HBox>                                                                                                                                                                                                                                                
    </content>                                                                                                                                                                                                                                                 
    </Page>&nbsp;&nbsp;&nbsp;&nbsp;                                                                                                                                                                                                                            
</mvc:View>                                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                               