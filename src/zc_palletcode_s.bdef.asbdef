projection;
strict;
use draft;

define behavior for ZC_PalletCode_S alias PalletCodeAll

{
  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use association _PalletCode { create; with draft; }
}

define behavior for ZC_PalletCode alias PalletCode

{
  use update;
  use delete;

  use association _PalletCodeAll { with draft; }
}