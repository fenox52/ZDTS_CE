sap.ui.define([                                                                                                                                                                                                                                                
    "sap/ui/core/mvc/Controller",                                                                                                                                                                                                                              
    "sap/m/BusyDialog",                                                                                                                                                                                                                                        
    "sap/m/MessageBox",                                                                                                                                                                                                                                        
    "sap/ui/core/UIComponent"&nbsp;&nbsp;&nbsp;&nbsp;                                                                                                                                                                                                          
], (Controller, BusyDialog, MessageBox,UIComponent) => {                                                                                                                                                                                                       
    "use strict";                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
    return Controller.extend("procordconfirm.controller.Main", {                                                                                                                                                                                               
        onInit() {                                                                                                                                                                                                                                             
            var oRouter = UIComponent.getRouterFor(this);                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
            oRouter.getRoute("RouteMain").attachPatternMatched(this._onMainMatched,this);                                                                                                                                                                      
            //Handle hotkeys                                                                                                                                                                                                                                   
            $(document).keydown(jQuery.proxy(this.onKeyDown, this));                                                                                                                                                                                           
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        _onMainMatched: function () {                                                                                                                                                                                                                          
            var oInput = this.getView().byId("FldProcOrder");                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            if (oInput) {                                                                                                                                                                                                                                      
                oInput.setValue("");&nbsp;                                                                                                                                                                                                                     
            }                                                                                                                                                                                                                                                  
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        onPhaseChange: function (oEvent) {                                                                                                                                                                                                                     
            var oInput = oEvent.getSource();                                                                                                                                                                                                                   
            var sValue = oInput.getValue();                                                                                                                                                                                                                    
            //Set input to 4 numeric                                                                                                                                                                                                                           
            if (sValue.length > 4) {                                                                                                                                                                                                                           
                oInput.setValue(sValue.slice(0, 4));                                                                                                                                                                                                           
            }                                                                                                                                                                                                                                                  
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        onKeyDown: function (oEvent) {                                                                                                                                                                                                                         
            // F3 - Back                                                                                                                                                                                                                                       
            if (oEvent.key === "F3") {                                                                                                                                                                                                                         
                oEvent.preventDefault();                                                                                                                                                                                                                       
                this.onBackMain();                                                                                                                                                                                                                             
            }                                                                                                                                                                                                                                                  
        },                                                                                                                                                                                                                                                     
        onProceedMain: function (evt) {                                                                                                                                                                                                                        
            //Set busy loading screen                                                                                                                                                                                                                          
            var oBusyDialog = new BusyDialog({});                                                                                                                                                                                                              
            oBusyDialog.open();                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
            var oModel = this.getView().getModel();                                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
            var oInputControl = this.getView().byId("FldProcOrder");                                                                                                                                                                                           
            var vFldProcOder = oInputControl.getValue();                                                                                                                                                                                                       
            oInputControl = this.getView().byId("FldPhase");                                                                                                                                                                                                   
            var vFldPhase = oInputControl.getValue();                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
            var sPath = "/ProcOrdGetDtl(ProcessOrder='" + vFldProcOder + "',Operation='" + vFldPhase + "')/Set";                                                                                                                                               
                                                                                                                                                                                                                                                               
            oModel.read(sPath, {                                                                                                                                                                                                                               
                success: function (oData) {                                                                                                                                                                                                                    
                    var oRouter = this.getOwnerComponent().getRouter();                                                                                                                                                                                        
                                                                                                                                                                                                                                                               
                    oRouter.navTo("View1",                                                                                                                                                                                                                     
                        {                                                                                                                                                                                                                                      
                            ProcOrder: vFldProcOder,                                                                                                                                                                                                           
                            Phase: vFldPhase                                                                                                                                                                                                                   
                        });                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                               
                    oBusyDialog.close();                                                                                                                                                                                                                       
                }.bind(this),                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
                error: function (oError) {                                                                                                                                                                                                                     
                    oBusyDialog.close();                                                                                                                                                                                                                       
                    var sMsg = JSON.parse(oError.responseText).error.message.value;                                                                                                                                                                            
                    sMsg = sMsg.replace(/&&/g, '');                                                                                                                                                                                                            
                    MessageBox.error(sMsg, { title: "Error" });                                                                                                                                                                                                
                }                                                                                                                                                                                                                                              
            });                                                                                                                                                                                                                                                
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        onAfterRendering: function () {                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                               
            setTimeout(() => {                                                                                                                                                                                                                                 
                this.getView().byId("FldProcOrder").focus();                                                                                                                                                                                                   
            }, 100);                                                                                                                                                                                                                                           
                                                                                                                                                                                                                                                               
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        onBackMain: function (oEvent) {                                                                                                                                                                                                                        
            //return to home page                                                                                                                                                                                                                              
            var oCrossAppNavigator = sap.ushell.Container.getService("CrossApplicationNavigation");                                                                                                                                                            
            oCrossAppNavigator.toExternal({                                                                                                                                                                                                                    
                target: { semanticObject: "Shell", action: "home" }                                                                                                                                                                                            
            });                                                                                                                                                                                                                                                
        }                                                                                                                                                                                                                                                      
    });                                                                                                                                                                                                                                                        
});                                                                                                                                                                                                                                                            