<mvc:View controllerName="procordconfirm.controller.Main"                                                                                                                                                                                                      
    xmlns:mvc="sap.ui.core.mvc"                                                                                                                                                                                                                                
    xmlns="sap.m"                                                                                                                                                                                                                                              
    xmlns:form="sap.ui.layout.form"&nbsp;&nbsp;&nbsp;&nbsp;                                                                                                                                                                                                    
    >                                                                                                                                                                                                                                                          
    <Page id="page" title="{i18n>title}">                                                                                                                                                                                                                      
        <content>                                                                                                                                                                                                                                              
            <HBox id="Hb1">                                                                                                                                                                                                                                    
                <Button id="BackMain" text="F3 - Back"                                                                                                                                                                                                         
                        press="onBackMain" />&nbsp;                                                                                                                                                                                                            
            </HBox>                                                                                                                                                                                                                                            
        </content>                                                                                                                                                                                                                                             
                                                                                                                                                                                                                                                               
        <VBox id="VBox1">                                                                                                                                                                                                                                      
	    <form:SimpleForm id="SForm1"&nbsp;                                                                                                                                                                                                                        
                         layout="ResponsiveGridLayout"&nbsp;&nbsp;                                                                                                                                                                                             
                         class="centerLabelsForm"                                                                                                                                                                                                              
                         labelSpanXL="2"                                                                                                                                                                                                                       
                         labelSpanL="2"                                                                                                                                                                                                                        
                         labelSpanM="2"                                                                                                                                                                                                                        
                         labelSpanS="6"                                                                                                                                                                                                                        
                         adjustLabelSpan="false"                                                                                                                                                                                                               
                         emptySpanXL="4"                                                                                                                                                                                                                       
                         emptySpanL="4"                                                                                                                                                                                                                        
                         emptySpanM="4"                                                                                                                                                                                                                        
                         emptySpanS="0"                                                                                                                                                                                                                        
                         columnsXL="1"                                                                                                                                                                                                                         
                         columnsL="1"                                                                                                                                                                                                                          
                         columnsM="1"                                                                                                                                                                                                                          
                         singleContainerFullSize="false"                                                                                                                                                                                                       
                         editable="true">                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
            <form:content>&nbsp;                                                                                                                                                                                                                               
            <Label text="Proc.Order" width="100px" />                                                                                                                                                                                                          
            <Input id="FldProcOrder"                                                                                                                                                                                                                           
                   type="Text"&nbsp;&nbsp;&nbsp;&nbsp;                                                                                                                                                                                                         
                   maxLength="12"&nbsp;                                                                                                                                                                                                                        
                   width="150px"                                                                                                                                                                                                                               
                   showValueHelp="false"/>&nbsp;                                                                                                                                                                                                               
                                                                                                                                                                                                                                                               
            <Label text="Oper./Phase" width="100px"/>&nbsp;                                                                                                                                                                                                    
                                                                                                                                                                                                                                                               
            <Input id="FldPhase"                                                                                                                                                                                                                               
                   type="Number"&nbsp;                                                                                                                                                                                                                         
                   value="0020"&nbsp;                                                                                                                                                                                                                          
                   maxLength="4"                                                                                                                                                                                                                               
                   width="50px"                                                                                                                                                                                                                                
                   liveChange="onPhaseChange"/>&nbsp;                                                                                                                                                                                                          
            </form:content>                                                                                                                                                                                                                                    
        </form:SimpleForm>                                                                                                                                                                                                                                     
     	</VBox>                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
        <content>                                                                                                                                                                                                                                              
            <HBox id="Hb2">                                                                                                                                                                                                                                    
        <Button id="ProceedMain" text="Proceed"                                                                                                                                                                                                                
                press="onProceedMain" />&nbsp;&nbsp;                                                                                                                                                                                                           
            </HBox>                                                                                                                                                                                                                                            
        </content>&nbsp;&nbsp;&nbsp;&nbsp;                                                                                                                                                                                                                     
    </Page>                                                                                                                                                                                                                                                    
</mvc:View>                                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                               
                                                                                                                                                                                                                                                               